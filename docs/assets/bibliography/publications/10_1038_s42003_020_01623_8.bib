@article{10_1038_s42003_020_01623_8,
  title = {{Chromosomal scale assembly of parasitic wasp genome reveals symbiotic virus colonization}},
  author = {Gauthier, Jérémy and Boulain, Hélène and van Vugt, Joke J. F. A. and Baudry, Lyam and Persyn, Emma and Aury, Jean-Marc and Noel, Benjamin and Bretaudeau, Anthony and Legeai, Fabrice and Warris, Sven and Chebbi, Mohamed A. and Dubreuil, Géraldine and Duvic, Bernard and Kremer, Natacha and Gayral, Philippe and Musset, Karine and Josse, Thibaut and Bigot, Diane and Bressac, Christophe and Moreau, Sébastien and Periquet, Georges and Harry, Myriam and Montagné, Nicolas and Boulogne, Isabelle and Sabeti-Azad, Mahnaz and Maïbèche, Martine and Chertemps, Thomas and Hilliou, Frédérique and Siaussat, David and Amselem, Joëlle and Luyten, Isabelle and Capdevielle-Dulac, Claire and Labadie, Karine and Merlin, Bruna Laís and Barbe, Valérie and de Boer, Jetske G. and Marbouty, Martial and Cônsoli, Fernando Luis and Dupas, Stéphane and Hua-Van, Aurélie and Le Goff, Gaelle and Bézier, Annie and Jacquin-Joly, Emmanuelle and Whitfield, James B. and Vet, Louise E. M. and Smid, Hans M. and Kaiser, Laure and Koszul, Romain and Huguet, Elisabeth and Herniou, Elisabeth A. and Drezen, Jean-Michel},
  year = {2021},
  doi = {10.1038/s42003-020-01623-8},
  url = {https://doi.org/10.1038/s42003-020-01623-8},
  date = {2021-01-22},
  abstract = {Abstract Endogenous viruses form an important proportion of eukaryote genomes and a source of novel functions. How large DNA viruses integrated into a genome evolve when they confer a benefit to their host, however, remains unknown. Bracoviruses are essential for the parasitism success of parasitoid wasps, into whose genomes they integrated \textasciitilde{}103 million years ago. Here we show, from the assembly of a parasitoid wasp genome at a chromosomal scale, that bracovirus genes colonized all ten chromosomes of Cotesia congregata . Most form clusters of genes involved in particle production or parasitism success. Genomic comparison with another wasp, Microplitis demolitor , revealed that these clusters were already established \textasciitilde{}53 mya and thus belong to remarkably stable genomic structures, the architectures of which are evolutionary constrained. Transcriptomic analyses highlight temporal synchronization of viral gene expression without resulting in immune gene induction, suggesting that no conflicts remain between ancient symbiotic partners when benefits to them converge.},
  journal = {Communications Biology},
  publisher = {Springer Science and Business Media LLC},
  volume = {4},
  number = {1}
}
